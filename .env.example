# Copy to .env and fill in what you use:   cp .env.example .env
# .env is git-ignored. Real environment variables always take precedence.
# Only YOUTUBE_API_KEY + the Google Sheets pair are required for the core flow.

# ── Core ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=                 # YouTube Data API v3 (~10k units/day free)
GOOGLE_CREDS_FILE=               # absolute path to a Google service-account JSON
SHEET_NAME=                      # Google Sheet (workbook) shared with that service account
# WORKSHEET_NAME=Youtube         # creator tab name (default: Youtube)

# ── LLM gates (optional; keyword rules are used when unset) ──────────
GROQ_API_KEY=                    # or put it in a git-ignored src/.groq_key file
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=

# ── Contact discovery (optional) ─────────────────────────────────────
# GITHUB_TOKEN=                  # raises GitHub API rate limit; works without
# SERPER_API_KEY=                # Google SERP fallback when DuckDuckGo throttles

# ── Email verification cascade (optional: Reoon → Hunter → ZeroBounce) ─
# REOON_API_KEY=
# HUNTER_API_KEY=
# ZEROBOUNCE_API_KEY=

# ── Email finders (optional: Apollo → Prospeo → Snov.io) ─────────────
# APOLLO_API_KEY=
# PROSPEO_API_KEY=
# SNOV_CLIENT_ID=
# SNOV_CLIENT_SECRET=
